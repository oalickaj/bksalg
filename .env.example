# ---------------------------------------------------------------
# Kopier til .env.local (lokalt) og legg de samme inn i Vercel.
# ALDRI legg service role-nøkkelen i en variabel som starter med NEXT_PUBLIC_.
# ---------------------------------------------------------------

# Supabase → Project Settings → API
SUPABASE_URL=https://abcdefghijkl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...hemmelig

# Brevo → Settings → SMTP & API → API Keys (gratis, 300 eposter/dag)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=din-verifiserte-adresse@eksempel.no
EMAIL_FROM_NAME=Billettsalg

# Bare skoleeposter på dette domenet godtas (flere kan skilles med komma)
ALLOWED_EMAIL_DOMAIN=skole.example.no

# Vipps-nummeret elevene skal betale til
VIPPS_NUMBER=123456

# Når salget åpner. Uten tidssone tolkes det som norsk tid (Europe/Oslo).
SALES_OPEN_AT=2026-11-05T12:00
# Valgfritt: når salget stenger (tom = aldri)
SALES_CLOSE_AT=

# Passord til /admin (minst 12 tegn – bruk noe langt og tilfeldig)
ADMIN_PASSWORD=bytt-meg-til-noe-langt-og-tilfeldig

# Valgfritt
EVENT_NAME=Skolebal 2026
TICKET_PRICE=250
# Maks påmeldingsforsøk per IP-adresse per vindu (se README om skolenettverk)
RATE_LIMIT_PER_IP=60
RATE_LIMIT_WINDOW_SECONDS=60
